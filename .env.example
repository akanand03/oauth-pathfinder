# Model provider: "openrouter" (default), "gemini" or "groq"
LLM_PROVIDER=openrouter

# Required when LLM_PROVIDER=openrouter: OpenRouter API key (https://openrouter.ai/settings/keys).
# Free (":free") models allow 20 requests/minute and 50/day per account (1,000/day after buying 10 credits).
OPENROUTER_API_KEY=

# Optional: comma-separated fallback lists of free models, tried in order. Keep only ":free" IDs,
# or a fallback to a paid model will be billed.
OPENROUTER_EXTRACT_MODELS=nvidia/nemotron-3.5-super-vl:free,xingchen-agi/xing4.0-29b-a4b:free,dots-studio/dots-3-note-preview:free
OPENROUTER_WRITE_MODELS=nvidia/nemotron-3.5-super-vl:free,xingchen-agi/xing4.0-29b-a4b:free,dots-studio/dots-3-note-preview:free

# Required when LLM_PROVIDER=gemini: Gemini API key from https://aistudio.google.com/apikey
# Free-tier limits (requests/tokens per minute and per day) are shown per project at
# https://aistudio.google.com/rate-limit. Some projects aren't eligible for the free tier;
# those need billing linked at https://aistudio.google.com/billing.
GEMINI_API_KEY=

# Optional: Gemini models (fast/cheap for per-page extraction, strongest free-tier model for the write)
GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite
GEMINI_WRITE_MODEL=gemini-3.8-flash

# Required when LLM_PROVIDER=groq: Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b
GROQ_WRITE_MODEL=openai/gpt-oss-120b

# Optional: max tokens of trimmed text per page. 4000 keeps each extraction call around 5k tokens,
# under small free-tier per-minute limits (e.g. Groq's 8k tokens/minute).
PAGE_TOKEN_CAP=4000

# Required for generation: Tavily web search (free tier: 1,000 searches/month, https://app.tavily.com).
TAVILY_API_KEY=

# Optional: Composio API key for the managed-auth check (https://platform.composio.dev).
# Without it, the Composio section is marked Uncertain.
COMPOSIO_API_KEY=

# Optional locally, required on Vercel: Upstash Redis REST credentials.
# Without them, guides, caches and rate limits live in memory and vanish on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cost guards for the generate endpoint. The daily cap defaults to 8 on OpenRouter (4 calls per guide
# against the 50 free requests/day) and 30 otherwise; leave it unset to use that default.
RATE_LIMIT_PER_HOUR=3
GLOBAL_DAILY_LIMIT=
